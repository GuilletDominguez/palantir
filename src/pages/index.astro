---
import Game from '../components/Game.astro';
import SkillPanel from '../components/SkillPanel.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<a
		href="/resumen/"
		class="sr-only z-50 bg-px-y px-4 py-3 font-pixel text-xs text-px-o focus:not-sr-only focus:absolute focus:top-4 focus:left-1/2 focus:-translate-x-1/2"
		>Ver el portfolio sin jugar</a
	>
	<h1 class="sr-only">Palantir — portfolio de 8 bits</h1>
	<noscript>
		<p class="bg-px-y p-4 text-center font-pixel text-xs leading-relaxed text-px-o">
			El pueblo necesita JavaScript. <a href="/resumen/" class="underline">Ver la versión rápida del portfolio</a>.
		</p>
	</noscript>
	<Game />
	<SkillPanel />
</Layout>
