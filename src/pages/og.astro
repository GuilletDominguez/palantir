---
// Tarjeta para compartir en redes (Open Graph), a 1200 × 630. No es una página
// para visitar: scripts/generate-og.mjs la fotografía y guarda public/og.png.
// Usa los mismos sprites y fuentes que el pueblo.
import PixelIcon from '../components/PixelIcon.astro';
import { profile } from '../data/profile';
import { DEFAULT_OUTFIT, dress } from '../game/outfit';
import { BODY_FRONT, HEAD_DOWN, ICONS, LEGS_FRONT } from '../game/sprites';
import { STATUE_BUST } from '../game/statue';
import Layout from '../layouts/Layout.astro';

const hero = dress([...HEAD_DOWN, ...BODY_FRONT, ...LEGS_FRONT[0]], { ...DEFAULT_OUTFIT, hat: 'wizard' });
const icons = ['vue', 'svelte', 'css', 'cyber', 'python', 'certs'].map((id) => ICONS[id]);
const skills = ['Vue', 'React', 'Svelte', 'CSS', 'Ciberseguridad', 'Python'];
---

<Layout title="Tarjeta para compartir" noindex>
	<div class="og">
		<div class="art" aria-hidden="true">
			<div class="statue"><PixelIcon sprite={STATUE_BUST} size={300} /></div>
			<div class="hero"><PixelIcon sprite={hero} size={150} /></div>
		</div>
		<div class="text">
			<p class="kicker">Portfolio jugable de 8 bits</p>
			<h1>{profile.name}</h1>
			<p class="role">{profile.role} · {profile.headline}</p>
			<ul class="skills">{skills.map((s) => <li>{s}</li>)}</ul>
			<div class="icons">{icons.map((sprite) => <PixelIcon sprite={sprite} size={56} />)}</div>
			<p class="url">guillermo-dominguez.pages.dev</p>
		</div>
	</div>
</Layout>

<style>
	:global(body) {
		margin: 0;
		overflow: hidden;
	}
	.og {
		box-sizing: border-box;
		width: 1200px;
		height: 630px;
		display: grid;
		grid-template-columns: 380px 1fr;
		align-items: stretch;
		gap: 36px;
		padding: 0 56px 0 0;
		background: var(--color-px-o);
		border: 12px solid var(--color-px-y);
		box-shadow: inset 0 0 0 6px var(--color-px-o);
	}
	/* La estatua y el héroe sobre un trozo de césped, como en la plaza */
	.art {
		position: relative;
		background: linear-gradient(to bottom, transparent 80%, #8f563b 80%, #8f563b 82%, #38b764 82%);
	}
	.statue {
		position: absolute;
		left: 24px;
		bottom: 70px;
		image-rendering: pixelated;
	}
	.hero {
		position: absolute;
		right: 0;
		bottom: 40px;
	}
	.text {
		display: grid;
		gap: 16px;
		align-content: center;
	}
	.kicker {
		margin: 0;
		font-family: var(--font-pixel);
		font-size: 18px;
		color: var(--color-px-g);
	}
	h1 {
		margin: 0;
		font-family: var(--font-pixel);
		font-size: 30px;
		line-height: 1.4;
		color: var(--color-px-w);
		text-shadow: 4px 4px 0 var(--color-px-B);
	}
	.role {
		margin: 0;
		font-family: var(--font-body);
		font-size: 30px;
		line-height: 1.05;
		color: var(--color-px-y);
	}
	.skills {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.skills li {
		padding: 2px 10px;
		font-family: var(--font-body);
		font-size: 24px;
		color: var(--color-px-c);
		background: var(--color-px-B);
		border: 3px solid var(--color-px-o);
	}
	.icons {
		display: flex;
		gap: 14px;
	}
	.url {
		margin: 0;
		font-family: var(--font-pixel);
		font-size: 16px;
		color: var(--color-px-q);
	}
</style>
