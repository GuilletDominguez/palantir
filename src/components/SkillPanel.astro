---
import { skills } from '../skills/registry';
import VueShop from '../skills/vue/VueShop.vue';
import QuestBoard from '../skills/react/QuestBoard';
import AlchemyLab from '../skills/svelte/AlchemyLab.svelte';
import AboutPanel from './AboutPanel.astro';
import HobbiesPanel from './HobbiesPanel.astro';
---

<dialog
	id="skill-dialog"
	class="pixel-frame m-auto max-h-[calc(100dvh-2rem)] w-[min(68rem,calc(100vw-2rem))] overflow-y-auto bg-px-o p-0 text-px-w backdrop:bg-px-o/70"
	aria-labelledby="skill-dialog-title"
>
	<form method="dialog" class="sticky top-0 z-10 flex items-center justify-between gap-4 bg-px-B px-5 py-3">
		<h2 id="skill-dialog-title" class="font-pixel text-xs text-px-y sm:text-sm"></h2>
		<button class="cursor-pointer border-2 border-px-o bg-px-r px-3 py-2 font-pixel text-[0.6rem] text-px-w" aria-label="Cerrar"
			>ESC ✕</button
		>
	</form>

	<section data-panel="welcome" data-title="¡Bienvenido!" hidden class="grid gap-4 p-6 text-xl leading-snug">
		<p>
			Este pueblo es mi portfolio. Cada edificio es una skill, construida con su propia tecnología y siguiendo sus
			buenas prácticas.
		</p>
		<p>La estatua del centro de la plaza soy yo: acércate para saber más sobre mí. Y si quieres conocer qué hago fuera del código, pásate por la tienda de Aficiones.</p>
		<p>Acércate a una puerta y pulsa <kbd class="font-pixel text-sm text-px-g">A</kbd> para entrar.</p>
		<p class="text-px-q">Todo el pueblo (sprites incluidos) está dibujado con código en un &lt;canvas&gt;.</p>
	</section>

	<section data-panel="about" data-title="Sobre mí" hidden>
		<AboutPanel />
	</section>

	<section data-panel="hobbies" data-title="Aficiones" hidden>
		<HobbiesPanel />
	</section>

	{
		skills.map((skill) => (
			<section data-panel={skill.id} data-title={skill.name} hidden class="grid gap-6 p-5 lg:grid-cols-[minmax(0,1fr)_20rem]">
				<div class="min-w-0">
					<p class="mb-4 text-xl text-px-q">{skill.tagline}</p>
					{skill.id === 'vue' && <VueShop client:visible />}
					{skill.id === 'react' && <QuestBoard client:visible />}
					{skill.id === 'svelte' && <AlchemyLab client:visible />}
					{!skill.ready && (
						<p class="font-pixel text-xs leading-loose text-px-y">🚧 Edificio en construcción.</p>
					)}
				</div>

				{skill.practices.length > 0 && (
					<aside class="sign self-start" aria-label={`Cartel: buenas prácticas de ${skill.name}`}>
						<h3 class="mb-3 font-pixel text-[0.65rem] leading-relaxed text-px-y">Buenas prácticas</h3>
						<ul class="grid gap-3">
							{skill.practices.map((p) => (
								<li>
									<strong class="block font-pixel text-[0.55rem] leading-relaxed text-px-w">{p.title}</strong>
									<span class="text-lg leading-tight text-px-y/90">{p.detail}</span>
								</li>
							))}
						</ul>
					</aside>
				)}
			</section>
		))
	}
</dialog>

<style>
	/* Cartel de madera con los mismos tonos que el sprite del juego */
	.sign {
		padding: 1rem 1.1rem;
		background: repeating-linear-gradient(
			to bottom,
			var(--color-px-k) 0 22px,
			#5a3a28 22px 24px
		);
		border: 4px solid var(--color-px-o);
		box-shadow: inset 0 0 0 2px #5a3a28;
	}
	dialog[open] {
		animation: pop 0.18s steps(3);
	}
	@keyframes pop {
		from {
			transform: scale(0.9);
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		dialog[open] {
			animation: none;
		}
	}
</style>

<script>
	import { $activePanel } from '../stores/ui';

	const dialog = document.querySelector<HTMLDialogElement>('#skill-dialog')!;
	const title = dialog.querySelector<HTMLElement>('#skill-dialog-title')!;
	const panels = dialog.querySelectorAll<HTMLElement>('[data-panel]');

	$activePanel.subscribe((id) => {
		if (!id) {
			if (dialog.open) dialog.close();
			return;
		}
		panels.forEach((p) => {
			const active = p.dataset.panel === id;
			p.hidden = !active;
			if (active) title.textContent = p.dataset.title ?? '';
		});
		if (!dialog.open) dialog.showModal();
	});

	dialog.addEventListener('close', () => $activePanel.set(null));
	// Cerrar al pulsar en el fondo
	dialog.addEventListener('click', (e) => {
		if (e.target === dialog) dialog.close();
	});
</script>
