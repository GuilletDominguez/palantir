---
import { withBase } from '../lib/url';
// El juego es JavaScript plano: no necesita framework ni hidratación,
// Astro empaqueta el <script> y lo carga como módulo.
import { INITIAL_PLAYER } from '../state/economy';
import { levelFor, nextLevelXp } from '../state/catalog';

// El HTML del servidor muestra la partida inicial; el script la sustituye
// por la guardada en cuanto carga.
const start = INITIAL_PLAYER;
---

<div class="relative h-dvh w-full overflow-hidden bg-px-d">
	<canvas id="world" class="block h-full w-full [image-rendering:pixelated]" aria-label="Pueblo del portfolio" role="img"
	></canvas>

	<div
		id="hud"
		class="pixel-frame pointer-events-none absolute top-4 left-4 grid gap-2 bg-px-o px-3 py-2 font-pixel text-[0.55rem] text-px-w sm:text-[0.65rem]"
		aria-label="Estado de la partida"
		role="group"
	>
		<p class="flex items-center gap-2">
			<span class="coin" aria-hidden="true"></span>
			<span class="sr-only">Oro:</span>
			<span data-gold class="text-px-y">{start.gold}</span>
		</p>
		<p class="flex items-center gap-2">
			<span>NV <span data-level>{levelFor(start.xp)}</span></span>
			<span
				role="meter"
				aria-label="Experiencia"
				aria-valuemin="0"
				aria-valuenow={start.xp}
				aria-valuemax={nextLevelXp(start.xp) ?? start.xp}
				class="block h-2 w-14 border-2 border-px-Q bg-px-B"
			>
				<span data-xp-bar class="block h-full bg-px-c" style="width: 0%"></span>
			</span>
		</p>
	</div>

	<!-- Para quien no tiene tiempo de jugar: siempre a la vista -->
	<a
		href={withBase('/')}
		class="pixel-frame absolute top-4 right-4 bg-px-y px-3 py-2 font-pixel text-[0.55rem] text-px-o hover:bg-px-w focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-px-w sm:text-[0.65rem]"
		>Versión rápida →</a
	>

	<div
		id="prompt"
		hidden
		class="pixel-frame pointer-events-none absolute top-24 left-1/2 -translate-x-1/2 bg-px-o px-4 py-3 font-pixel text-[0.6rem] whitespace-nowrap text-px-w sm:top-4 sm:text-xs"
		aria-live="polite"
	>
		<span data-label class="text-px-y"></span> · pulsa <kbd class="text-px-g">A</kbd> / <kbd class="text-px-g">Enter</kbd>
	</div>

	<p
		class="pointer-events-none absolute bottom-3 left-3 hidden font-pixel text-[0.55rem] text-px-w/80 [@media(pointer:fine)]:block"
	>
		Muévete con <kbd>WASD</kbd> o flechas
	</p>

	<div
		id="game-toast"
		hidden
		role="status"
		aria-live="polite"
		class="pixel-frame pointer-events-none absolute inset-x-4 bottom-6 mx-auto max-w-xl bg-px-w px-5 py-4 font-pixel text-[0.6rem] leading-loose text-px-o sm:text-xs pointer-coarse:bottom-48"
	>
		<p data-text class="min-h-[2lh]"></p>
		<span class="toast-arrow absolute right-4 bottom-2 text-px-r" aria-hidden="true">▼</span>
	</div>

	<div id="touch" class="pointer-events-none absolute inset-x-0 bottom-0 hidden p-5 [@media(pointer:coarse)]:block">
		<div class="flex items-end justify-between">
			<div class="pointer-events-auto grid grid-cols-3 grid-rows-3 gap-1">
				<button data-dir="up" aria-label="Arriba" class="dpad col-start-2">▲</button>
				<button data-dir="left" aria-label="Izquierda" class="dpad col-start-1 row-start-2">◀</button>
				<button data-dir="right" aria-label="Derecha" class="dpad col-start-3 row-start-2">▶</button>
				<button data-dir="down" aria-label="Abajo" class="dpad col-start-2 row-start-3">▼</button>
			</div>
			<button
				data-action
				aria-label="Interactuar"
				class="pointer-events-auto size-16 touch-none rounded-full border-4 border-px-o bg-px-r font-pixel text-lg text-px-w select-none active:bg-px-O"
				>A</button
			>
		</div>
	</div>
</div>

<style>
	.dpad {
		width: 3rem;
		height: 3rem;
		touch-action: none;
		user-select: none;
		background: var(--color-px-B);
		color: var(--color-px-w);
		border: 3px solid var(--color-px-o);
		font-size: 1rem;
		opacity: 0.85;
	}
	.dpad:active {
		background: var(--color-px-Q);
	}
	/* Moneda de 8 bits hecha con un box-shadow escalonado */
	.coin {
		width: 0.7em;
		height: 0.7em;
		background: var(--color-px-y);
		box-shadow:
			inset -0.15em -0.15em 0 var(--color-px-O),
			0 0 0 0.12em var(--color-px-o);
	}
	.hud-flash {
		animation: flash 0.5s steps(4);
	}
	@keyframes flash {
		50% {
			color: var(--color-px-w);
		}
	}
	.toast-arrow {
		visibility: hidden;
	}
	#game-toast[data-done='true'] .toast-arrow {
		visibility: visible;
		animation: blink 0.6s steps(2) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.hud-flash,
		#game-toast[data-done='true'] .toast-arrow {
			animation: none;
		}
	}
</style>

<script>
	import { startGame } from '../game/engine';
	import { startHud } from '../game/hud';
	import { syncTailorForm } from '../game/outfit-sync';

	syncTailorForm();

	startHud({
		hud: document.querySelector('#hud'),
		toast: document.querySelector('#game-toast'),
	});

	startGame({
		canvas: document.querySelector('#world'),
		touch: document.querySelector('#touch'),
		prompt: document.querySelector('#prompt'),
	});
</script>
