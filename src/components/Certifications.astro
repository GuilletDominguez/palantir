---
// Galería de certificaciones (edificio de Certificaciones y versión rápida).
// Cada miniatura abre el diploma en grande con la Popover API: un botón con
// `popovertarget` y un elemento con `popover`. Sin JavaScript, se cierra con
// Esc o pulsando fuera, y queda por encima del <dialog> del pueblo.
import { Image } from 'astro:assets';
import { CERT_GROUPS, certifications, formatDate, totalHours } from '../data/certifications';

// idPrefix: prefijo de los ids, por si la galería aparece dos veces en la misma página.
const { idPrefix = 'cert' } = Astro.props;
const byGroup = CERT_GROUPS.map((group) => ({
	group,
	items: certifications.filter((c) => c.group === group).sort((a, b) => b.date.localeCompare(a.date)),
}));
---

<div class="grid gap-6">
	<p class="text-xl leading-snug text-px-q">
		{certifications.length} certificaciones · {totalHours} horas de formación. Pulsa una para verla en grande y comprobarla
		en la web de quien la emite.
	</p>

	{
		byGroup.map(({ group, items }) => (
			<section class="grid gap-3">
				<h3 class="font-pixel text-[0.65rem] leading-relaxed text-px-g">
					{group} <span class="text-px-q">({items.length})</span>
				</h3>
				<ul class="grid gap-3 [grid-template-columns:repeat(auto-fill,minmax(14rem,1fr))]">
					{items.map((c) => {
						const popoverId = `${idPrefix}-${c.id}`;
						return (
							<li class="cert">
								<button
									type="button"
									class="thumb"
									popovertarget={popoverId}
									aria-label={`Ver en grande: ${c.title}`}
								>
									<Image src={c.image} widths={[320, 480]} sizes="(min-width: 640px) 16rem, 90vw" alt="" loading="lazy" />
								</button>
								<div class="grid gap-1 p-3">
									<p class="text-lg leading-tight text-px-w">{c.title}</p>
									<p class="text-base leading-tight text-px-q">
										{c.kind} · {c.hours} h · {formatDate(c.date)}
									</p>
								</div>

								<div id={popoverId} popover class="viewer" aria-label={c.title}>
									<Image src={c.image} width={1600} alt={`Diploma de ${c.issuer}: ${c.title}`} loading="lazy" />
									<div class="flex flex-wrap items-center justify-between gap-3">
										<p class="text-lg leading-tight text-px-w">
											{c.title} <span class="text-px-q">· {c.issuer} · {formatDate(c.date)}</span>
										</p>
										<div class="flex gap-2">
											<a class="action" href={c.verifyUrl} target="_blank" rel="noopener noreferrer">
												Verificar ↗
											</a>
											<button type="button" class="action close" popovertarget={popoverId} popovertargetaction="hide">
												Cerrar ✕
											</button>
										</div>
									</div>
								</div>
							</li>
						);
					})}
				</ul>
			</section>
		))
	}
</div>

<style>
	.cert {
		display: grid;
		align-content: start;
		background: var(--color-px-B);
		border: 2px solid var(--color-px-o);
	}
	.thumb {
		display: block;
		padding: 0;
		cursor: zoom-in;
		background: var(--color-px-w);
		border: 0;
		border-bottom: 2px solid var(--color-px-o);
	}
	.thumb :global(img) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1600 / 1131;
	}
	.thumb:hover :global(img) {
		opacity: 0.85;
	}
	.thumb:focus-visible {
		outline: 3px solid var(--color-px-y);
		outline-offset: -3px;
	}
	/* El visor: Popover API. El navegador lo centra con inset: 0 + margin: auto,
	   pero el preflight de Tailwind pone margin: 0 a todo, así que se restaura. */
	.viewer {
		inset: 0;
		margin: auto;
		height: fit-content;
		width: min(64rem, 94vw);
		max-height: 94dvh;
		overflow: auto;
		padding: 0.8rem;
		gap: 0.8rem;
		color: var(--color-px-w);
		background: var(--color-px-o);
		border: 4px solid var(--color-px-y);
	}
	.viewer:popover-open {
		display: grid;
	}
	.viewer::backdrop {
		background: rgb(26 28 44 / 0.8);
	}
	.viewer :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
	.action {
		cursor: pointer;
		font-family: var(--font-pixel);
		font-size: 0.55rem;
		padding: 0.45rem 0.6rem;
		color: var(--color-px-o);
		background: var(--color-px-y);
		border: 2px solid var(--color-px-o);
	}
	.action.close {
		color: var(--color-px-w);
		background: var(--color-px-r);
	}
	.action:focus-visible {
		outline: 2px solid var(--color-px-w);
		outline-offset: 2px;
	}
</style>
