---
import cardCss from './sec-card.css?url';

const { header } = Astro.props;

// Declarative Shadow DOM: el <template shadowrootmode> se convierte en la
// sombra del elemento al parsear el HTML, sin JavaScript. <sec-card> ni
// siquiera necesita estar registrado. Ojo con dos trampas de Astro:
// - Los estilos de la sombra van en sec-card.css, enlazado con <link> dentro de
//   la plantilla: un <style> en línea necesitaría un hash en la CSP, y Astro no
//   los calcula para lo marcado como is:inline.
// - `<slot is:inline>`: si no, Astro lo toma por uno de SUS slots de componente
//   y, como nadie le pasa contenido, no pinta nada.
// El contenido va en el light DOM (con slots), así lo indexan los buscadores
// y lo leen los lectores de pantalla.
---

<sec-card>
	<template shadowrootmode="open">
		<link rel="stylesheet" href={cardCss} />
		<article>
			<slot is:inline name="name"></slot>
			<slot is:inline name="stops"></slot>
			<slot is:inline></slot>
		</article>
	</template>
	<h4 slot="name" class="name">{header.name}</h4>
	<p slot="stops" class="stops">Frena: {header.stops}</p>
	<p class="what">{header.what}</p>
	<code class="example">{header.example}</code>
</sec-card>

<style>
	/*
	 * El contenido proyectado se estiliza desde FUERA de la sombra: en la
	 * cascada, los estilos del documento ganan a ::slotted(). Con ::slotted, el
	 * preflight de Tailwind (h4 { font-size: inherit }) pisaba el tamaño.
	 */
	sec-card :is(h4, p) {
		margin: 0;
	}
	.name {
		font-family: var(--font-pixel);
		font-size: 0.55rem;
		line-height: 1.6;
		color: var(--color-px-y);
		overflow-wrap: anywhere;
	}
	.stops {
		font-size: 1.05rem;
		line-height: 1.1;
		color: var(--color-px-O);
	}
	.what {
		font-size: 1.1rem;
		line-height: 1.15;
	}
	.example {
		font-family: var(--font-body);
		font-size: 1rem;
		color: var(--color-px-c);
		word-break: break-all;
	}
</style>
